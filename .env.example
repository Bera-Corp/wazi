# Copy to .env.local and fill in connection metadata for your own dev host.
# Keep the private key in your SSH directory, outside this repository.
WAZI_DEV_HOST=your-tailnet-host-or-ip
WAZI_DEV_DNS=your-host.your-tailnet.ts.net
WAZI_DEV_SSH_PORT=22
WAZI_DEV_SSH_USER=your-development-user
WAZI_DEV_SSH_KEY_PATH=C:/Users/your-user/.ssh/your-development-key
WAZI_DEV_SSH_KEY_FINGERPRINT=your-public-key-fingerprint
WAZI_DEV_EXPECTED_HOST=your-hostname
WAZI_DEV_ENVIRONMENT_STATUS=unverified
