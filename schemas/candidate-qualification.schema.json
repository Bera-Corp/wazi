{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wazi.dev/schemas/v1/candidate-qualification.schema.json",
  "title": "Wazi Candidate Qualification Receipt",
  "description": "Signed, candidate-digest-bound evidence from an isolated synthetic qualification runner. The record declares isolation; it does not prove runner enforcement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "qualificationId", "tenantScope", "candidateDigest", "result",
    "runnerId", "runnerVersion", "suiteDigest", "startedAt", "completedAt",
    "isolation", "tests", "signature"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "qualificationId": { "type": "string", "pattern": "^qual_[A-Za-z0-9_-]{1,96}$" },
    "tenantScope": { "type": "string", "minLength": 1, "maxLength": 128 },
    "candidateDigest": { "$ref": "common.schema.json#/$defs/sha256Digest" },
    "result": { "enum": ["passed", "failed"] },
    "runnerId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "runnerVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
    "suiteDigest": { "$ref": "common.schema.json#/$defs/sha256Digest" },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["syntheticProject", "network", "liveVolumeAccess", "privileged", "cpuMilli", "ramMb", "storageMb"],
      "properties": {
        "syntheticProject": { "const": true },
        "network": { "const": "deny-egress" },
        "liveVolumeAccess": { "const": false },
        "privileged": { "const": false },
        "cpuMilli": { "type": "integer", "minimum": 1, "maximum": 2000 },
        "ramMb": { "type": "integer", "minimum": 64, "maximum": 4096 },
        "storageMb": { "type": "integer", "minimum": 64, "maximum": 10240 }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["testId", "result"],
        "properties": {
          "testId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "result": { "enum": ["passed", "failed"] }
        }
      }
    },
    "signature": { "$ref": "common.schema.json#/$defs/signature" }
  },
  "allOf": [
    {
      "if": { "properties": { "result": { "const": "passed" } }, "required": ["result"] },
      "then": {
        "properties": {
          "tests": {
            "items": {
              "properties": { "result": { "const": "passed" } },
              "required": ["result"]
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "result": { "const": "failed" } }, "required": ["result"] },
      "then": {
        "properties": {
          "tests": {
            "contains": {
              "properties": { "result": { "const": "failed" } },
              "required": ["result"]
            },
            "minContains": 1
          }
        }
      }
    }
  ]
}
