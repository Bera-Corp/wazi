{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wazi.dev/schemas/v1/package-composition.schema.json",
  "title": "Wazi Reviewed Package Composition",
  "description": "Candidate dependency composition. Validation is not signing, qualification, or runtime authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "compositionId", "applicationId", "profile", "components", "recoveryGroups"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "compositionId": {"type": "string", "pattern": "^composition_[A-Za-z0-9_-]+$"},
    "applicationId": {"type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"},
    "profile": {"enum": ["standalone", "immich-no-ml"]},
    "components": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "role", "manifestRef", "dependsOn", "limits", "readiness", "secretRefs"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
          "role": {"enum": ["postgresql", "immich-postgresql", "mysql", "nginx", "immich-server", "cache"]},
          "manifestRef": {"$ref": "common.schema.json#/$defs/recordRef"},
          "dependsOn": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "limits": {
            "type": "object", "additionalProperties": false, "required": ["cpuCores", "ramMb", "storageMb"],
            "properties": {"cpuCores": {"type": "number", "exclusiveMinimum": 0}, "ramMb": {"type": "integer", "minimum": 16}, "storageMb": {"type": "integer", "minimum": 0}}
          },
          "readiness": {"enum": ["postgres-authenticated", "mysql-authenticated", "nginx-config-and-http", "immich-http", "cache-authenticated"]},
          "secretRefs": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/secretRef"}}
        }
      }
    },
    "recoveryGroups": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "members", "strategy"],
        "properties": {"id": {"type": "string", "minLength": 1}, "members": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "strategy": {"enum": ["database-logical", "quiesced-database-and-media", "configuration-checkpoint"]}}
      }
    }
  }
}
