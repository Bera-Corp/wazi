{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wazi.dev/schemas/v1/phase1-signing-policy.schema.json",
  "title": "Wazi Phase 1 Offline Signing Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "algorithms", "trustedSigners"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "algorithms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "const": "sigstore-cosign" }
    },
    "trustedSigners": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyId", "publicKeyPem"],
        "properties": {
          "keyId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "publicKeyPem": {
            "type": "string",
            "minLength": 80,
            "pattern": "^-----BEGIN PUBLIC KEY-----[\\s\\S]+-----END PUBLIC KEY-----\\s*$"
          }
        }
      }
    }
  }
}
